<Window x:Class="ChichiCapture.WindowPicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="캡처할 창 선택" Width="560" Height="520" WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False" PreviewKeyDown="Window_KeyDown">
 <DockPanel Margin="14">
  <TextBlock DockPanel.Dock="Top" Text="캡처할 창을 선택하세요" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/>
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="새로고침" Click="Refresh_Click" Padding="12,6"/><Button Content="취소" IsCancel="True" Padding="12,6"/><Button Content="선택한 창 캡처" Click="Capture_Click" IsDefault="True" Padding="14,6"/></StackPanel>
  <ListBox x:Name="WindowList" MouseDoubleClick="WindowList_DoubleClick" FontSize="14"><ListBox.ItemTemplate><DataTemplate><Border Padding="10" BorderBrush="#E0E3EA" BorderThickness="0,0,0,1"><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
 </DockPanel>
</Window>
