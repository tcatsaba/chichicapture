<Window x:Class="ChichiCapture.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="설정" Width="570" Height="260" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><CheckBox x:Name="Auto" Content="캡처 직후 PNG 자동 저장"/><StackPanel Grid.Row="1" Orientation="Horizontal"><TextBlock Text="저장 폴더" Width="90"/><TextBox x:Name="Folder" Width="360"/><Button Content="찾기" Click="Browse_Click"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal"><TextBlock Text="영역 단축키" Width="90"/><CheckBox x:Name="Ctrl" Content="Ctrl"/><CheckBox x:Name="Shift" Content="Shift" Margin="10,0"/><CheckBox x:Name="Alt" Content="Alt"/><ComboBox x:Name="KeyBox" Width="90" Margin="12,0"/></StackPanel><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="취소" IsCancel="True"/><Button Content="저장" Click="Save_Click"/></StackPanel></Grid></Window>
